{
    // Default: latexmk with the shared repo config (latexmkrc in the repo root).
    // It runs LuaLaTeX as often as needed (incl. BibTeX/Biber) and makes
    // template/ and the repo root searchable, so documents need no paths.
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-r",
                "%WORKSPACE_FOLDER%/latexmkrc",
                "%DOC%"
            ]
        },
        {
            "name": "lualatex",
            "command": "lualatex",
            "args": [
                "--synctex=1",
                "--interaction=nonstopmode",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (LuaLaTeX, Repo-Config)",
            "tools": ["latexmk"]
        },
        {
            "name": "lualatex (einmal, ohne Repo-Config)",
            "tools": ["lualatex"]
        }
    ],
    "latex-workshop.latex.recipe.default": "first",

    "files.exclude": {
        "**/*.aux": true,
        "**/*.log": true,
        "**/*.fls": true,
        "**/*.fdb_latexmk": true,
        "**/*.synctex.gz": true,
        "**/*.toc": true,
        "**/*.out": true,
        "**/*.bbl": true,
        "**/*.snm": true,
        "**/*.nav": true
    }
}
